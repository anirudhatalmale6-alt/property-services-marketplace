# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=4000
# Public URL of the frontend — used in emails/SMS links and CORS.
APP_URL=http://localhost:5173
# Public URL of this API.
API_URL=http://localhost:4000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/marketplace?schema=public"

# ---------------------------------------------------------------- auth
# 32+ random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set true when the API is served over HTTPS (production). Controls the
# Secure flag on the session cookies.
COOKIE_SECURE=false

# Brute-force guard on login/register/change-password, per IP.
# The defaults below ARE the production values. The automated test suites sign
# in dozens of times in a row, so raise this locally when running them —
# the server refuses a value above 100 when NODE_ENV=production.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# ---------------------------------------------------------------- money
CURRENCY=USD
# Driver: "stripe" for real cards, "mock" to simulate checkout locally
# without any Stripe account. The MVP ships on mock until your Stripe keys
# exist, and switching is this one line.
PAYMENTS_DRIVER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------ messaging
# Driver: "log" writes the message to the DB + stdout (dev), "smtp" sends it.
EMAIL_DRIVER=log
EMAIL_FROM="Property Services <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Driver: "log" or "twilio".
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------- storage
# Driver: "local" writes under UPLOAD_DIR, "s3" uses the bucket below.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# -------------------------------------------------------------- seeding
# Password given to the demo accounts created by `npm run seed`.
# Seeding refuses to run in production unless SEED_ALLOW_PROD=true.
SEED_PASSWORD=DemoPass123!
