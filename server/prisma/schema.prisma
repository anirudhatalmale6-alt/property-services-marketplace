// Home inspection marketplace — Phase 1 (MVP) data model.
//
// Design notes that matter for the "nationwide-ready" requirement (SOP §13):
//  * Geography is DATA, not code. A ServiceArea row (zip/city/state) is what
//    makes a market live. Launching a new state = inserting rows.
//  * No state-specific terminology anywhere in the schema. `jurisdiction` is a
//    plain string on the credential, never a column named after one state.
//  * Platform fee is NOT hard-coded (SOP §10). Payout is derived from a
//    configurable rule — see Service.payoutMode / Setting `payout.*`.
//  * Money is stored in integer minor units (cents). Never floats.
//  * Job state lives in ONE enum on Job, and every transition is appended to
//    JobEvent, so "track the status of their order" and the admin audit trail
//    read from the same source.
//  * A Job is claimed with a conditional UPDATE (see assignment.js), so two
//    providers tapping Accept at the same instant cannot both win.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  DRAFT // account made, onboarding not submitted
  PENDING // submitted, waiting on admin review
  APPROVED // may see and accept jobs
  REJECTED
  SUSPENDED
}

enum JobStatus {
  PENDING_PAYMENT // booked but checkout not completed
  OPEN // paid, on the marketplace, nobody assigned
  ASSIGNED // a provider has claimed it
  EN_ROUTE
  IN_PROGRESS
  AWAITING_REPORT // work done, required document not yet uploaded
  COMPLETED // report in, ready for payout
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING // job complete, owed to provider
  PROCESSING
  PAID
  FAILED
}

enum DocumentKind {
  LICENSE // inspector onboarding: state license / certification
  INSURANCE // inspector onboarding: liability cover
  IDENTITY // inspector onboarding: photo ID
  JOB_REPORT // deliverable for a completed job
  JOB_PHOTO
  OTHER
}

/// Credential types an inspector can hold. Kept generic: a credential is
/// scoped to a `jurisdiction` string, never to a column named after a state.
enum CredentialKind {
  LICENSE
  CERTIFICATION
  INSURANCE
  BOND
  OTHER
}

/// How an inspector's pay is derived for a service. SOP §10 forbids a
/// hard-coded fee percentage, so this is data, not code.
enum PayoutMode {
  PERCENT // a share of what the customer is charged
  FIXED // a flat amount per job
}

/// Which property attribute a price rule reacts to.
enum PriceRuleKind {
  SQFT_TIER // square footage falls within [minValue, maxValue]
  AGE_OVER // property older than minValue years
  ADD_ON // optional extra the customer selects (pool, spa, septic…)
}

enum DocumentReviewState {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum ExceptionKind {
  PAYMENT_FAILED
  NO_PROVIDER_FOUND // job sat OPEN past its window
  JOB_OVERDUE
  REPORT_MISSING
  PAYOUT_FAILED
  REFUND_REQUESTED
  PROVIDER_CANCELLED
  OTHER
}

enum ExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------------------------------------------------------------- identity

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  fullName     String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer       CustomerProfile?
  provider       ProviderProfile?
  addresses      Address[]
  jobs           Job[] // jobs booked as the customer
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  resolvedIssues JobException[]  @relation("ExceptionResolver")
  reviewedDocs   Document[]      @relation("DocumentReviewer")

  @@index([role])
}

// Rotating refresh tokens — storing the hash so a DB leak can't mint sessions.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id           String         @id @default(uuid())
  userId       String         @unique
  businessName String
  legalName    String? // SOP §4: legal name may differ from trading name
  bio          String?
  status       ProviderStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewNotes  String?
  payoutRef    String? // Stripe Connect account id, once onboarded
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  services    ProviderService[]
  areas       ProviderServiceArea[]
  credentials InspectorCredential[]
  documents   Document[]
  jobs        Job[]
  payouts     Payout[]

  @@index([status])
}

/// SOP §4 and §13: state/jurisdiction is stored SEPARATELY from the credential,
/// and an inspector may hold several — one per state they serve, plus insurance.
/// `expiresAt` is what an expiry-alert job will read.
model InspectorCredential {
  id           String         @id @default(uuid())
  providerId   String
  kind         CredentialKind @default(LICENSE)
  jurisdiction String? // e.g. "TX". Null for non-state credentials like insurance.
  number       String
  issuedBy     String? // licensing authority, free text — varies by state
  issuedAt     DateTime?
  expiresAt    DateTime?
  documentId   String? // the uploaded proof, if any
  reviewState  DocumentReviewState @default(PENDING)
  reviewNotes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  document Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([jurisdiction])
  @@index([expiresAt])
}

// ------------------------------------------------------------ catalogue

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  sortOrder Int      @default(0)
  services Service[]
}

model Service {
  id               String  @id @default(uuid())
  categoryId       String
  name             String
  slug             String  @unique
  shortDescription String
  description      String

  /// Starting price before any property-based rules are applied.
  basePriceCents Int

  /// How the inspector's pay is worked out (SOP §10 — never hard-coded).
  /// PERCENT: payoutPercentBp basis points of the final customer price.
  /// FIXED:   providerPayCents flat, regardless of the final price.
  /// A null payoutPercentBp falls back to the global `payout.defaultPercentBp`
  /// setting, so the business can change every service's split in one place.
  payoutMode       PayoutMode @default(PERCENT)
  payoutPercentBp  Int? // 8000 = 80.00%
  providerPayCents Int? // used when payoutMode = FIXED

  durationMinutes Int     @default(60)
  requiresReport  Boolean @default(true)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  /// Property attributes this service asks the customer for at booking.
  collectsSquareFeet Boolean @default(false)
  collectsYearBuilt  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   ServiceCategory   @relation(fields: [categoryId], references: [id])
  providers  ProviderService[]
  priceRules ServicePriceRule[]
  jobs       Job[]

  @@index([isActive])
}

/// Configurable pricing (SOP §3.6 "price according to configurable pricing
/// rules"). Admin-editable rows, so square-footage bands, an age surcharge and
/// optional add-ons can all change without a deploy.
model ServicePriceRule {
  id         String        @id @default(uuid())
  serviceId  String
  kind       PriceRuleKind
  label      String // shown to the customer, e.g. "2,000–2,999 sq ft"
  /// SQFT_TIER: inclusive square-footage bounds.
  /// AGE_OVER:  minValue = age in years the surcharge starts at.
  /// ADD_ON:    bounds unused.
  minValue   Int?
  maxValue   Int?
  amountCents Int         @default(0)
  isActive   Boolean       @default(true)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, kind, isActive])
}

model ProviderService {
  providerId String
  serviceId  String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
}

// A market. Rows here are what "we operate in this place" means — no code
// knows about any particular city.
model ServiceArea {
  id        String   @id @default(uuid())
  name      String // "North Dallas"
  zip       String
  city      String
  state     String // two-letter state / jurisdiction code
  country   String   @default("US")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  providers ProviderServiceArea[]
  jobs      Job[]

  @@unique([zip, country])
  @@index([state])
  @@index([isActive])
}

model ProviderServiceArea {
  providerId    String
  serviceAreaId String

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  area     ServiceArea     @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceAreaId])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String? // "Home", "Rental #2"
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String   @default("US")
  notes     String? // gate code, dog on site, lockbox
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([userId])
}

// ------------------------------------------------------------------- work

model Job {
  id            String    @id @default(uuid())
  reference     String    @unique // human-quotable: PS-7F3K9Q
  customerId    String
  serviceId     String
  addressId     String
  serviceAreaId String?
  providerId    String?

  status JobStatus @default(PENDING_PAYMENT)

  scheduledStart DateTime
  scheduledEnd   DateTime
  customerNotes  String?

  /// Property details captured at booking (SOP §3.3). These are inputs to the
  /// price, so they are stored on the job, not just on the address.
  squareFeet Int?
  yearBuilt  Int?

  /// Who is paying (SOP §3.5).
  payerType String @default("CUSTOMER") // CUSTOMER | REALTOR | COMPANY
  payerName String?

  // Price snapshotted at booking. Changing the catalogue or the fee rules
  // later must never retroactively alter what someone was charged or what an
  // inspector was promised.
  priceCents       Int
  providerPayCents Int

  /// Itemised record of how priceCents was reached — base, each rule that
  /// fired, and the payout rule applied. Kept so a customer query or a dispute
  /// is answered from evidence rather than by re-running today's pricing.
  priceBreakdown Json?

  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   User            @relation(fields: [customerId], references: [id])
  service    Service         @relation(fields: [serviceId], references: [id])
  address    Address         @relation(fields: [addressId], references: [id])
  area       ServiceArea?    @relation(fields: [serviceAreaId], references: [id])
  provider   ProviderProfile? @relation(fields: [providerId], references: [id])
  events     JobEvent[]
  documents  Document[]
  payment    Payment?
  payout     Payout?
  exceptions JobException[]

  @@index([status])
  @@index([customerId])
  @@index([providerId])
  @@index([serviceAreaId, status])
  @@index([scheduledStart])
}

// Append-only transition log. Both the customer tracker and the admin audit
// view render from this, so they can never disagree.
model JobEvent {
  id        String     @id @default(uuid())
  jobId     String
  fromStatus JobStatus?
  toStatus  JobStatus
  actorId   String?
  actorRole Role?
  note      String?
  createdAt DateTime   @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Document {
  id          String       @id @default(uuid())
  kind        DocumentKind
  providerId  String?
  jobId       String?
  // Storage is behind an adapter: `key` is local-disk-relative in dev and an
  // object key in S3 in production. Callers never build a path themselves.
  storageKey  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  reviewState DocumentReviewState @default(PENDING)
  reviewedById String?
  reviewedAt  DateTime?
  reviewNotes String?
  expiresAt   DateTime? // insurance/licence expiry
  createdAt   DateTime     @default(now())

  provider    ProviderProfile?      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  job         Job?                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reviewedBy  User?                 @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  credentials InspectorCredential[]

  @@index([providerId, kind])
  @@index([jobId])
  @@index([reviewState])
}

// ----------------------------------------------------------------- money

model Payment {
  id            String        @id @default(uuid())
  jobId         String        @unique
  amountCents   Int
  currency      String        @default("USD")
  status        PaymentStatus @default(REQUIRES_PAYMENT)
  provider      String        @default("stripe")
  externalId    String? // payment intent id
  clientSecret  String?
  failureReason String?
  paidAt        DateTime?
  refundedCents Int           @default(0)
  refundedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Payout {
  id            String       @id @default(uuid())
  jobId         String       @unique
  providerId    String
  amountCents   Int
  currency      String       @default("USD")
  status        PayoutStatus @default(PENDING)
  externalId    String?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id])

  @@index([providerId, status])
  @@index([status])
}

// Idempotency guard for payment webhooks: a provider retrying a delivery must
// not credit a job twice.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  externalId  String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
}

// -------------------------------------------------------- comms + triage

model Notification {
  id          String              @id @default(uuid())
  userId      String?
  channel     NotificationChannel
  template    String
  recipient   String // email address or E.164 number, snapshotted
  subject     String?
  body        String
  status      NotificationStatus  @default(QUEUED)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

model JobException {
  id           String          @id @default(uuid())
  jobId        String?
  kind         ExceptionKind
  status       ExceptionStatus @default(OPEN)
  detail       String
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime        @default(now())

  job        Job?  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ExceptionResolver", fields: [resolvedById], references: [id])

  @@index([status, kind])
  @@index([jobId])
}

// Key/value platform settings so an admin can change behaviour without a deploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
